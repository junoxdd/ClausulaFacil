rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: contracts
    // Document ID: {contractId}
    // Fields:
    //   - id: string (required) - Unique identifier
    //   - userId: string (required, immutable) - The user ID of the owner
    //   - date: string (required, immutable) - Creation date
    //   - title: string (required) - Title of the contract
    //   - text: string (required) - The raw text of the contract
    //   - analysis: map (required) - The analysis result from Gemini
    //   - folder: string (optional)
    //   - tags: list (optional)
    //   - status: string (optional)
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - userId: string (required, immutable)
    //   - plan: string (required)
    //   - analysesCount: number (required)
    //   - autoDeleteDays: number (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (resource == null || request.auth.uid == resource.data.userId);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function uidUnchanged() {
      return !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid;
    }

    function uidNotModified() {
      return !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidContract(data) {
      return hasRequiredFields(['id', 'userId', 'date', 'title', 'text', 'analysis']) &&
             hasOnlyAllowedFields(['id', 'userId', 'date', 'title', 'text', 'analysis', 'folder', 'tags', 'status']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() < 100 &&
             data.date is string && data.date.size() > 0 && data.date.size() < 50 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             data.text is string && data.text.size() > 0 && data.text.size() < 1000000 &&
             data.analysis is map &&
             (!('folder' in data) || (data.folder is string && data.folder.size() <= 100)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('status' in data) || (data.status in ["Em Negociação", "Assinado", "Cancelado", "Revisão Pendente"]));
    }

    function isValidUser(data) {
      return hasRequiredFields(['userId', 'plan', 'analysesCount']) &&
             hasOnlyAllowedFields(['userId', 'plan', 'analysesCount', 'autoDeleteDays']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() < 100 &&
             data.plan in ['free', 'pro', 'unlimited'] &&
             data.analysesCount is number && data.analysesCount >= 0 &&
             (!('autoDeleteDays' in data) || (data.autoDeleteDays is number && data.autoDeleteDays >= 0));
    }

    match /contracts/{contractId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && 
                    isValidContract(request.resource.data) && 
                    uidUnchanged();
      allow update: if isDocOwner() && 
                    isValidContract(request.resource.data) && 
                    uidNotModified() && 
                    areImmutableFieldsUnchanged(['userId', 'date']);
      allow delete: if isDocOwner();
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                    isValidUser(request.resource.data) &&
                    request.resource.data.userId == userId &&
                    request.resource.data.plan == 'free' &&
                    request.resource.data.analysesCount == 0;
      allow update: if isOwner(userId) &&
                    isValidUser(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.plan == resource.data.plan &&
                    (request.resource.data.analysesCount == resource.data.analysesCount || 
                     request.resource.data.analysesCount == resource.data.analysesCount + 1);
    }
  }
}
